# ========================================================
# QuizX Live — Environment Configuration Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Host Security
# Passcode required to access host dashboard and control quiz lifecycles
HOST_SECRET=quizx-host-2026

# Supabase PostgreSQL Configuration
# (Optional for local development / testing; if omitted, QuizX Live runs seamlessly on its high-speed in-memory store)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Frontend Environment Variables (Vite)
# Set these on Vercel or in client/.env for production
VITE_SERVER_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
